{
  "name": "proxypilot",
  "version": "0.1.0",
  "private": true,
  "description": "Bulk proxy browser launcher: one isolated browser profile per proxy, launch them all at once and open a website on every one.",
  "type": "module",
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "express": "^5.3.0",
    "playwright": "^1.64.1",
    "proxy-chain": "^3.0.1",
    "tsx": "^4.23.15",
    "undici": "^7.30.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
